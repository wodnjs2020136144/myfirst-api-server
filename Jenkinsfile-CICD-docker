pipeline {
  agent any

  environment {
    GIT_URL                  = 'https://github.com/wodnjs2020136144/myfirst-api-server.git'
    GIT_BRANCH               = 'main'
    GIT_ID                   = 'skala-github-id'          // GitHub PAT credential ID
    IMAGE_NAME               = 'sk345-webserver'
    IMAGE_TAG                = '1.0'
    IMAGE_REGISTRY_URL       = 'skala-registry.skala-ai.com'
    IMAGE_REGISTRY_PROJECT   = 'class-10'
    DOCKER_CREDENTIAL_ID     = 'skala-image-registry-id'  // Harbor 인증 정보 ID
    KUBECONFIG_CREDENTIAL_ID = 'sk345-kubeconfig'         // 본인 kubeconfig (Secret file)
    K8S_NAMESPACE            = 'class-10'
    DEPLOYMENT_NAME          = 'sk345-myfirst-api-server' // kustomize/base/deployment.yaml 의 metadata.name 과 동일
  }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  stages {
    stage('Clone Repository') {
      steps {
        echo 'Clone Repository'
        git branch: "${GIT_BRANCH}", url: "${GIT_URL}", credentialsId: "${GIT_ID}"
        sh 'ls -al'
      }
    }

    stage('Build with Maven') {
      steps {
        echo 'Build with Maven'
        sh 'mvn clean package -DskipTests'
        sh 'ls -al'
      }
    }

    stage('Image Build & Push (BuildKit)') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
          sh '''
            set -eux
            REG_HOST="${IMAGE_REGISTRY_URL}"
            FINAL_IMAGE_TAG="${IMAGE_TAG}-${BUILD_NUMBER}"
            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${FINAL_IMAGE_TAG}"

            echo "Login to $REG_HOST as $REG_USER"
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin "$REG_HOST"

            docker buildx build --platform "linux/amd64" -t "${IMAGE_REF}" --push .

            docker rmi "${IMAGE_REF}" || true
            docker logout "$REG_HOST" || true
          '''
        }
      }
    }

    stage('Update K8s Manifests') {
      steps {
        sh '''
          set -eux
          test -d ./kustomize/overlays/dev
          cd ./kustomize/overlays/dev

          FINAL_IMAGE_TAG="${IMAGE_TAG}-${BUILD_NUMBER}"
          IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"
          kustomize edit set image "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}"

          echo "--- AFTER ---"
          cat ./kustomization.yaml
        '''
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        // Jenkins 이미지에 박힌 class-0 kubeconfig 대신 본인 kubeconfig 사용
        withCredentials([file(credentialsId: "${KUBECONFIG_CREDENTIAL_ID}", variable: 'KUBECONFIG')]) {
          sh '''
            set -eux
            FINAL_IMAGE_TAG="${IMAGE_TAG}-${BUILD_NUMBER}"
            IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

            echo "=== [DEBUG] Deploy to Kubernetes stage ==="
            echo "K8S_NAMESPACE=${K8S_NAMESPACE}"
            echo "DEPLOYMENT_NAME=${DEPLOYMENT_NAME}"
            kubectl version --client 2>&1 | head -1 || echo "kubectl not found!"
            kustomize version 2>&1 | head -1 || echo "kustomize not found!"
            kubectl auth whoami -o jsonpath='{.status.userInfo.username}' || true
            echo

            echo "=== kustomize build 결과 적용 ==="
            kustomize build ./kustomize/overlays/dev | kubectl apply -n "${K8S_NAMESPACE}" -f -

            echo "=== 배포 롤아웃 대기 ==="
            kubectl rollout status deployment/"${DEPLOYMENT_NAME}" \
              -n "${K8S_NAMESPACE}" \
              --timeout=180s

            echo "=== 배포 완료: ${IMAGE_BASE}:${FINAL_IMAGE_TAG} ==="
            kubectl get pods -n "${K8S_NAMESPACE}" -l "app=${DEPLOYMENT_NAME}"
          '''
        }
      }
    }
  }

  post {
    always {
      deleteDir()  // 워크스페이스 정리 (git clone, target/, 빌드 아티팩트)
    }
  }
}
